# deps — the MCP server ships as a single bundled file in mcp/dist/,
# so node_modules is a build-time dependency only and must NOT be committed.
node_modules/

# TypeScript incremental build info
*.tsbuildinfo

# OS cruft
.DS_Store

# NOTE: mcp/dist/ IS committed on purpose — Claude Code runs no build step
# on plugin install, so the bundled server must already be present.

# stray session helper, not part of the plugin
continue.sh

__pycache__/

# LaTeX build litter from regenerating the demo figures
*.aux
*.log
*.out
*.toc

# rendered preset demos — regenerate with `python3 demos/render.py`.
# The sources and the figures under demos/ ARE committed; only the output is not.
demos/out/
