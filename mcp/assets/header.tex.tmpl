% Classic-but-tuned page furniture. Placeholders __TITLE__, __HEADER_RIGHT__,
% __LINK_COLOR__ are substituted by the MCP server before rendering.
\usepackage{xcolor}
\definecolor{Blue}{HTML}{__LINK_COLOR__} % muted dark blue for links
\usepackage{fancyhdr}
\usepackage{lastpage}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.2pt}
\fancyhead[L]{\small\itshape __TITLE__}
\fancyhead[R]{\small\itshape __HEADER_RIGHT__}
\fancyfoot[C]{\small Page \thepage\ of \pageref{LastPage}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\small Page \thepage\ of \pageref{LastPage}}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0.2pt}%
}
\setlength{\parskip}{0.5em}
% Palatino has no U+2192 glyph; map the arrow to a math arrow.
\usepackage{newunicodechar}
\newunicodechar{→}{\ensuremath{\rightarrow}}
