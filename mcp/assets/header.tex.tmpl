% Classic-but-tuned page furniture. Placeholders __TITLE__, __HEADER_RIGHT__,
% __LINK_COLOR__ are substituted by the MCP server before rendering.
\usepackage{xcolor}
\definecolor{Blue}{HTML}{__LINK_COLOR__} % muted dark blue for links
\usepackage{fancyhdr}
\usepackage{lastpage}
\pagestyle{fancy}
\fancyhf{}
% No rule under the header or above the footer.
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\itshape __TITLE__}
\fancyhead[R]{\small\itshape __HEADER_RIGHT__}
% Compact page marker "N/M" in the bottom-right corner.
\fancyfoot[R]{\small \thepage/\pageref{LastPage}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\small \thepage/\pageref{LastPage}}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}
\setlength{\parskip}{0.5em}

% Long monospace identifiers (e.g. http_server_requests_seconds_count) are a
% single unbreakable \texttt token and overrun narrow table columns. Redefine
% \texttt so it allows a line break after each `_`, `.`, `/`, `-` or `:` — the
% content is unchanged, it just wraps instead of colliding with the next cell.
\let\origtexttt\texttt
\renewcommand{\texttt}[1]{{%
  \def\_{\textunderscore\allowbreak}%
  \origtexttt{#1}%
}}

% The body fonts (Palatino / Latin Modern) have no glyphs for arrows or emoji,
% which otherwise render as empty boxes. Map the common ones to text/math
% equivalents so they at least carry their meaning.
\usepackage{newunicodechar}
% Arrows.
\newunicodechar{→}{\ensuremath{\rightarrow}}
\newunicodechar{←}{\ensuremath{\leftarrow}}
\newunicodechar{↔}{\ensuremath{\leftrightarrow}}
\newunicodechar{⇒}{\ensuremath{\Rightarrow}}
\newunicodechar{⇐}{\ensuremath{\Leftarrow}}
% Status emoji → coloured symbols.
\newunicodechar{✅}{\textcolor[HTML]{2E7D32}{\ensuremath{\checkmark}}}
\newunicodechar{✔}{\textcolor[HTML]{2E7D32}{\ensuremath{\checkmark}}}
\newunicodechar{☑}{\textcolor[HTML]{2E7D32}{\ensuremath{\checkmark}}}
\newunicodechar{❌}{\textcolor[HTML]{C62828}{\ensuremath{\times}}}
\newunicodechar{✖}{\textcolor[HTML]{C62828}{\ensuremath{\times}}}
\newunicodechar{✗}{\textcolor[HTML]{C62828}{\ensuremath{\times}}}
\newunicodechar{⚠}{\textbf{[!]}}
\newunicodechar{ℹ}{\textbf{[i]}}
% Bullets / misc.
\newunicodechar{•}{\ensuremath{\bullet}}
\newunicodechar{★}{\ensuremath{\star}}
\newunicodechar{☆}{\ensuremath{\star}}
