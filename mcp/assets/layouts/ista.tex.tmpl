% Layout: ista — ista brand palette on white paper.
%
% The full deck palette. Mint, green and orange are slide colours, tuned for a
% dark background: at body-text size on white they fail contrast, so they appear
% only as RULES and in code tokens, never as running prose. Navy carries
% everything that has to be read. The deck's #a0a8c0 grey is darkened to #5b6478
% to stay legible in print.
\definecolor{istaNavy}{HTML}{0c1033}       % headings, links, running head
\definecolor{istaNavyLight}{HTML}{161b4a}  % third-level headings
\definecolor{istaMint}{HTML}{1BEB83}       % table rules
\definecolor{istaGreen}{HTML}{34d399}      % code strings (darkened)
\definecolor{istaOrange}{HTML}{f59e0b}     % code numerals (darkened)
\definecolor{istaGray}{HTML}{5b6478}       % code comments, secondary text
\colorlet{Blue}{istaNavy} % links pick up the brand navy

% Table rules in the mint accent. A bright colour works here where it would not
% in text, because these are hairlines rather than glyphs. colortbl has to be
% loaded explicitly — pandoc's template does not, so \arrayrulecolor is otherwise
% an undefined control sequence and the whole document fails at \begin{document}.
\usepackage{colortbl}
\arrayrulecolor{istaMint}

% Code tokens in the brand palette rather than pandoc's default primaries.
% \AtBeginDocument because pandoc defines these macros in its own preamble, after
% this header include is read. \providecommand first: with --no-highlight the
% macros never exist, and a bare \renewcommand would fail.
\AtBeginDocument{%
  \providecommand{\KeywordTok}[1]{#1}%
  \providecommand{\DataTypeTok}[1]{#1}%
  \providecommand{\StringTok}[1]{#1}%
  \providecommand{\CommentTok}[1]{#1}%
  \providecommand{\DecValTok}[1]{#1}%
  \renewcommand{\KeywordTok}[1]{\textcolor{istaNavy}{\textbf{#1}}}%
  \renewcommand{\DataTypeTok}[1]{\textcolor{istaNavyLight}{#1}}%
  \renewcommand{\StringTok}[1]{\textcolor{istaGreen!65!black}{#1}}%
  \renewcommand{\CommentTok}[1]{\textcolor{istaGray}{\textit{#1}}}%
  \renewcommand{\DecValTok}[1]{\textcolor{istaOrange!75!black}{#1}}%
}

% This layout puts headings and running heads in \sffamily, but pandoc only
% sets mainfont and monofont — the sans family is left at xelatex's default,
% which is Latin Modern Sans. Against Palatino that reads as a mismatch (too
% light, wrong era). Optima is the natural partner: Zapf designed both, so the
% humanist proportions agree. Guarded so a missing font degrades to the default
% instead of failing the whole render.
\usepackage{fontspec}
\IfFontExistsTF{Optima}{\setsansfont{Optima}}{}

% Navy sans-serif headings against the serif body. Patched via \@startsection
% rather than sectsty/titlesec — neither ships with BasicTeX.
%
% \headcolor, not a bare \color: with --number-sections LaTeX emits the section
% number in a box that restores \normalcolor, which resets the heading to black
% halfway through. Neutralising \normalcolor inside the heading group makes the
% colour stick across both the number and the text.
% Only style headings if the TYPE partial did not already claim them: the
% layout is concatenated last, so an unguarded patch here would override a
% type that deliberately set its own hierarchy (see types/newspaper).
\ifdefined\headingsclaimed\else
\makeatletter
\newcommand{\headcolor}{\let\normalcolor\relax\color{istaNavy}}
\renewcommand{\section}{\@startsection{section}{1}{0pt}%
  {-3.5ex plus -1ex minus -.2ex}{2.3ex plus .2ex}%
  {\normalfont\Large\sffamily\bfseries\headcolor}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{0pt}%
  {-3.25ex plus -1ex minus -.2ex}{1.5ex plus .2ex}%
  {\normalfont\large\sffamily\bfseries\headcolor}}
% Third level steps down to the lighter navy, so the hierarchy has three visible
% tiers rather than two identical ones.
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{0pt}%
  {-3.25ex plus -1ex minus -.2ex}{1.5ex plus .2ex}%
  {\normalfont\normalsize\sffamily\bfseries\let\normalcolor\relax\color{istaNavyLight}}}
\makeatother
\fi

% KOMA types style headings through \setkomafont rather than \@startsection, so
% they skip the guarded block above entirely. Feed the same colour through the
% hook they provide, so `koma-*` presets still look like this layout.
\providecommand{\komaheadcolor}{}
\renewcommand{\komaheadcolor}{\color{istaNavy}}

% No rule under the running header: a full-width mint band reads as a banner on
% paper and fights the body copy. The brand shows up in the navy headings, the
% navy links and the coloured running heads instead.
\renewcommand{\headrulewidth}{0pt}

% This layout's running head is the one whose weight Gunnar wanted everywhere:
% a light sans, not small caps. Feed it through the hook so the newspaper type
% keeps the folio it puts on the right, and only set \fancyhead directly for
% types that provide no hook.
\providecommand{\newspaperheadfont}{}
\renewcommand{\newspaperheadfont}{\small\sffamily\color{istaNavy}}
\ifdefined\headingsclaimed\else
\fancyhead[L]{\small\sffamily\color{istaNavy}__TITLE__}
\fancyhead[R]{\small\sffamily\color{istaGray}__HEADER_RIGHT__}
\fi

% Newspaper headlines get a ruled box, in the brand navy. The hook only exists
% under the newspaper type, so declare-then-override — a bare \renewcommand would
% be an "undefined control sequence" under every other type reading this file.
% \linewidth, not \textwidth: inside multicol \textwidth is still the full
% page, so a \textwidth box overflows its column and runs across the others.
% \linewidth tracks the current column measure.
% \framebox with an explicit width, not \fbox: \fbox shrinks to its content, so
% headlines of different lengths produced boxes of different widths. \parbox lets
% a long headline wrap inside the box rather than overflowing the line.
\providecommand{\newspaperheadstyle}[1]{#1}
% Align the text INSIDE the box with the body text, not the frame. \fbox insets
% its content by \fboxrule+\fboxsep, so a box flush with \linewidth pushed the
% headline that far right of every other line in the column. Grow the box by that
% amount on each side and pull it back left by the same, with \hspace*: the frame
% now sits a hair outside the measure and the headline starts exactly on it.
\newlength{\newspaperboxpad}
\renewcommand{\newspaperheadstyle}[1]{%
  {\color{istaNavy}\fboxrule=0.8pt%
    \setlength{\newspaperboxpad}{\dimexpr\fboxrule+\fboxsep\relax}%
    \hspace*{-\newspaperboxpad}%
    \framebox[\dimexpr\linewidth+2\newspaperboxpad\relax][l]{%
      \parbox{\linewidth}{%
        \color{istaNavy}\strut\textsc{#1}\strut}}}%
}
