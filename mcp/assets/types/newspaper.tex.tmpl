% Type: newspaper — SCAFFOLD. Single column with a retro masthead. Shape this in
% the project it is meant for; the structure below is a starting point.
%
% Three columns on a landscape page. The server sets classoption=landscape
% (TYPE_CLASSES); geometry needs telling separately, below, or the class option
% rotates the paper without moving the text block.
%
% Open questions for that project: bylines, rules between stories, whether a
% lead story spans differently.
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage{fontspec}
\usepackage{multicol}

% geometry is already loaded by pandoc with the margin variable, so reuse it
% rather than re-passing options: \geometry applies landscape to the text block.
\geometry{landscape}

% Three-column body. multicol (not \twocolumn) balances the final page and
% cooperates with pandoc's output.
% The masthead has to span the full page, so \maketitle runs BEFORE multicols
% opens. pandoc emits \maketitle as the first thing in the body, and
% \AtBeginDocument hooks fire before that, so opening the environment here would
% trap the nameplate inside column one. Deferred via \@ifundefined on a flag that
% \maketitle sets: see the redefinition below, which opens the columns itself.
% Close only if \maketitle actually opened them: a document with no title emits
% no \maketitle, and an unmatched \end{multicols} is a hard error.
\makeatletter
\newif\ifnewspaper@columnsopen
\AtEndDocument{\ifnewspaper@columnsopen\end{multicols}\fi}
\makeatother
\setlength{\columnsep}{1.4em}
\setlength{\columnseprule}{0.4pt}

% pandoc emits every table as a longtable, which hard-errors inside multicols
% ("longtable not in 1-column mode") because it is built to break across pages in
% a single column. Alias it to a plain tabular: no page-breaking, but it renders
% inside a column. Keep newspaper tables small.
\usepackage{array}
\let\longtable\tabular
\let\endlongtable\endtabular
\renewcommand{\endhead}{}
\renewcommand{\endfirsthead}{}
\renewcommand{\endlastfoot}{}
\renewcommand{\endfoot}{}

% --- Masthead ---------------------------------------------------------------
% A 19th-century newspaper nameplate: a high-contrast Didone in even letter-
% spacing, sandwiched between a thick/thin rule pair, with a dateline strip
% underneath. Didot and Bodoni are the period-correct faces; fall back through
% them and finally to the body serif so the render never fails on a missing font.
% Probe first, then declare — declaring a missing family is a hard error, so the
% guard has to come before \newfontfamily, not after it.
\IfFontExistsTF{Didot}
  {\newfontfamily\mastheadfont{Didot}}
  {\IfFontExistsTF{Bodoni 72}
    {\newfontfamily\mastheadfont{Bodoni 72}}
    {\let\mastheadfont\rmfamily}}

% No letterspacing: the `soul` package's \so breaks on non-ASCII, and a
% hand-rolled inter-character macro is not worth the fragility. The nameplate
% relies on size and the rule pair instead.
% \@title and \@date are internal, so the whole redefinition sits inside
% \makeatletter … \makeatother. Without it `\@` is parsed as the end-of-sentence
% macro and xelatex dies with "You can't use \spacefactor in vertical mode".
\makeatletter
\renewcommand{\maketitle}{%
  \begin{center}
    % Thick rule over thin — the classic masthead sandwich.
    \rule{\textwidth}{1.6pt}\\[-0.35em]
    \rule{\textwidth}{0.4pt}\\[0.55em]
    {\mastheadfont\fontsize{40}{44}\selectfont \@title}\\[0.5em]
    \rule{\textwidth}{0.4pt}\\[-0.3em]
    \rule{\textwidth}{1.6pt}\\[0.35em]
    % Dateline strip: small caps, widely spaced, the way a broadsheet sets it.
    {\footnotesize\scshape
      \ifx\@date\@empty Late Edition\else\@date\fi
      \hfill Vol.~I, No.~1 \hfill Price Twopence}\\[-0.2em]
    \rule{\textwidth}{0.4pt}
  \end{center}
  \vspace{0.8em}
  % Open the columns AFTER the nameplate, so the masthead spans the full page
  % width instead of being trapped in column one.
  \begin{multicols}{3}%
  \global\newspaper@columnsopentrue%
}
\makeatother

% --- Body face --------------------------------------------------------------
% The body serif is chosen by the server (TYPE_FONTS in mcp/src/index.ts), not
% here: pandoc's -V mainfont wins over anything a header include does, and
% hardcoding \setmainfont would also stomp a font the caller asked for
% explicitly. The newspaper default is Hoefler Text — higher stroke contrast
% than Palatino and old-style figures, so "118.2" sits in the line rather than
% standing above it, and it shares the Didone register of the nameplate.
%
% Old-style figures still have to be requested here, since -V mainfont carries
% no font features.
\defaultfontfeatures[\rmfamily]{Numbers = OldStyle}

% Headlines. A newspaper's heading hierarchy has to be legible at a glance, so
% the levels differ in FACE and not only in size: the story head takes the Didot
% display face at \LARGE, the sub-head (the "deck") is small-caps in the body
% serif, and the third level is bold italic. Sized purely by points they were
% nearly indistinguishable — a 12pt bold next to an 11pt bold reads as one level.
%
% \headingsclaimed tells the layout partial that follows to leave \section alone;
% otherwise the layout's own patch would load last and win, and the display face
% would never appear. See the note in each layout.
\newcommand{\headingsclaimed}{}
\makeatletter
% Headline: display face, ALL CAPS, at a size that carries. Caps are the
% newspaper convention and they solve the weight problem — Didot ships no bold in
% this family, so \bfseries silently substitutes a face at roughly body size and
% the \LARGE is lost. Caps read as loud without needing weight at all.
%
\renewcommand{\section}{\@startsection{section}{1}{0pt}%
  {-3.4ex plus -1ex minus -.2ex}{1.4ex plus .2ex}%
  {\normalfont\Large\mastheadfont}}
% Deck: body serif, small-caps, clearly subordinate to the all-caps headline.
\renewcommand{\subsection}{\@startsection{subsection}{2}{0pt}%
  {-2.4ex plus -1ex minus -.2ex}{0.8ex plus .2ex}%
  {\normalfont\small\scshape}}
% Third level: italic, quietest of the three.
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{0pt}%
  {-2.0ex plus -1ex minus -.2ex}{0.6ex plus .2ex}%
  {\normalfont\normalsize\itshape}}

\makeatother

% All-caps headlines, the newspaper convention.
%
% Two traps here, both hit while building this:
%   1. \MakeUppercase in the \@startsection style argument does nothing useful —
%      that argument sets formatting, and the macro swallows what follows it
%      rather than the heading text. The uppercasing has to wrap \section and
%      transform its ARGUMENT.
%   2. Wrapping it inline is not enough either: the layout partial is
%      concatenated after this file, and if it redefines \section the wrapper is
%      discarded. \AtBeginDocument defers until every partial has been read.
% \texorpdfstring keeps the PDF bookmark in mixed case.
%
% \newspaperheadstyle is the per-layout hook: a layout sets it to decorate the
% headline text (a box, a rule, nothing). Default is plain, so a layout that
% ignores the hook gets an undecorated all-caps headline.
\providecommand{\newspaperheadstyle}[1]{#1}
% \section takes an optional argument (the short form used for the TOC and
% running head), so it cannot be redefined with a plain [1] — that fails with
% "Argument of \@argdef has an extra }" at \begin{document}. Both the starred and
% optional forms have to be declared, and with \long\def rather than
% \newcommand: inside \AtBeginDocument a \newcommand for an @-name re-declares on
% each expansion and trips the same error.
%
% Small capitals (Kapitälchen), NOT \MakeUppercase: the text keeps its own
% capitalisation, so real capitals stay full height and the lowercase letters
% become small capitals beside them. \MakeUppercase flattens that distinction and
% loses the shape a reader uses to tell a proper noun from the rest.
\makeatletter
\AtBeginDocument{%
  \let\newspaper@sec\section
  \def\section{\@ifstar{\newspaper@sec@s}{\@dblarg\newspaper@sec@n}}%
  \long\def\newspaper@sec@s#1{%
    \newspaper@sec*{\newspaperheadstyle{\textsc{#1}}}}%
  % Short form (#1) is left alone for the TOC and PDF bookmarks; only the printed
  % headline (#2) is decorated.
  \long\def\newspaper@sec@n[#1]#2{%
    \newspaper@sec[#1]{\newspaperheadstyle{\textsc{#2}}}}%
}
\makeatother

% --- Page furniture ---------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
% Thin rule under the running head. Heavier weights belong to the masthead;
% repeating them on every page reads as noise. Layouts may override.
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\scshape __TITLE__}
\fancyhead[R]{\small\scshape __HEADER_RIGHT__}
\fancyfoot[C]{\small \thepage/\pageref{LastPage}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\small \thepage/\pageref{LastPage}}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% Newspaper paragraphing: indent the first line, no vertical gap between
% paragraphs — the opposite of the report type's airy \parskip.
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.2em}
