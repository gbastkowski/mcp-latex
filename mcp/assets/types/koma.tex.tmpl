% Type: koma — a KOMA-Script article (scrartcl), for the same jobs as `report`
% but with KOMA's typography instead of the standard classes'.
%
% Why bother: KOMA computes its type area from the paper and font size (typearea)
% rather than taking a fixed margin, and it exposes heading fonts through
% \setkomafont / \addtokomafont. That one interface replaces the \@startsection
% patching the other types need — including the \let\normalcolor\relax trick,
% since KOMA colours the section NUMBER along with the text.
%
% fancyhdr coexists with scrartcl (KOMA warns about scrlayer-scrpage being
% preferable, but the page furniture below works and keeps every layout partial
% usable unchanged), so this type deliberately reuses the same furniture as
% `report`.
%
% The server sets documentclass=scrartcl (TYPE_CLASSES); a partial cannot.
\usepackage{fancyhdr}
\usepackage{lastpage}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\itshape __TITLE__}
\fancyhead[R]{\small\itshape __HEADER_RIGHT__}
\fancyfoot[R]{\small \thepage/\pageref{LastPage}}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\small \thepage/\pageref{LastPage}}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% Tell the layouts that follow to leave \section alone: KOMA headings are styled
% through \setkomafont, and an \@startsection patch would both fight that and
% throw away KOMA's own spacing. Layouts that honour the flag route their colour
% through \komaheadcolor instead (see below).
\newcommand{\headingsclaimed}{}

% \komaheadcolor is the hook a layout fills in to colour the headings. Default is
% no colour, so a layout that ignores it gets KOMA's plain black dispositions.
% \addtokomafont{disposition} covers every heading level at once — sections,
% subsections, the title, the TOC entries.
\providecommand{\komaheadcolor}{}
\AtBeginDocument{\addtokomafont{disposition}{\komaheadcolor}}

\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}

% --- Title block ------------------------------------------------------------
% Optional logo above the title, and the creation date and version below it.
%
% The stamp belongs HERE and nowhere else. It was in the page footer, which put a
% generation date on every single page — noise on a thirty-page document, and it
% competed with the folio for attention. A document is created once, so it says so
% once, on the first page under its own title.
%
% Nothing is discovered automatically: a file happening to be named logo.png near
% the input should not silently appear in a document.
%
% pandoc emits \maketitle only when the document has a title, so a titleless
% document never reaches any of this — and then there is nothing to sit under.
% graphicx is loaded explicitly because pandoc only loads it when the body itself
% contains an image.
\usepackage{graphicx}
% titling supplies \pretitle/\posttitle; it is in BasicTeX.
\usepackage{titling}
\makeatletter
\newcommand{\mcpl@logo}{__LOGO_PATH__}
\newcommand{\mcpl@stamp}{__DOC_STAMP__}
% \posttitle has to be set whenever EITHER a logo or a stamp is present, and it
% must close whatever \pretitle opened — hence the four-way split rather than two
% independent \ifx blocks.
\ifx\mcpl@logo\@empty
  \ifx\mcpl@stamp\@empty\else
    \posttitle{\par\end{center}%
      \begin{center}\small\mcpl@stamp\end{center}\vskip 0.5em}
  \fi
\else
  \pretitle{\begin{center}\includegraphics[height=48pt]{\mcpl@logo}\\[1.2em]%
    \LARGE}
  \ifx\mcpl@stamp\@empty
    \posttitle{\par\end{center}\vskip 0.5em}
  \else
    \posttitle{\par\end{center}%
      \begin{center}\small\mcpl@stamp\end{center}\vskip 0.5em}
  \fi
\fi
\makeatother
