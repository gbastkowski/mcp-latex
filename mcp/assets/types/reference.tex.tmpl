% Type: reference — long-form documentation, tens to hundreds of pages.
%
% Differs from `report` in ways that only matter at length:
%   - \chapter exists (the server sets documentclass=report for this type), so
%     numbering is chapter-scoped: 3.1, 3.2 rather than one 400-item run.
%   - a deeper TOC, always on — at this size it is the primary navigation.
%
% The server supplies the documentclass and the TOC/numbering defaults
% (TYPE_CLASSES / TYPE_DEFAULTS in mcp/src/index.ts); a partial cannot set either.
\usepackage{fancyhdr}
\usepackage{lastpage}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% One-sided running heads: chapter left, section right, page number bottom right.
% The LE/RO recto-verso split these used to carry is meaningless without twoside,
% which is off by default now that these are read on screen rather than bound.
\fancyhead[L]{\small\itshape\nouppercase{\leftmark}}
\fancyhead[R]{\small\itshape\nouppercase{\rightmark}}
\fancyfoot[R]{\small\thepage}
% Title, then the creation date and version the server substitutes.
\fancyfoot[L]{\small __TITLE__}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% \leftmark/\rightmark need the marks set; report sets \chaptermark from
% \chapter and \sectionmark from \section, but strips the number by default.
\renewcommand{\chaptermark}[1]{\markboth{\thechapter\quad #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}

% Reference text is scanned, not read start to finish: generous paragraph
% separation and no first-line indent make an entry easier to find on the page.
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}

% Chapter openings are quieter than the LaTeX default, which wastes a third of
% the page on "Chapter 3" above the title. Keep the page break, drop the drama.
\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{1.5em}%
  {\parindent\z@\raggedright\normalfont
    \interlinepenalty\@M
    \Large\bfseries \@chapapp\space\thechapter
    \par\nobreak\vskip 0.4em
    \huge\bfseries #1\par\nobreak
    \vskip 1.2em}}
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{1.5em}%
  {\parindent\z@\raggedright\normalfont
    \interlinepenalty\@M
    \huge\bfseries #1\par\nobreak
    \vskip 1.2em}}
\makeatother

% --- Title block ------------------------------------------------------------
% Optional logo above the title, and the creation date and version below it.
%
% The stamp belongs HERE and nowhere else. It was in the page footer, which put a
% generation date on every single page — noise on a thirty-page document, and it
% competed with the folio for attention. A document is created once, so it says so
% once, on the first page under its own title.
%
% Nothing is discovered automatically: a file happening to be named logo.png near
% the input should not silently appear in a document.
%
% pandoc emits \maketitle only when the document has a title, so a titleless
% document never reaches any of this — and then there is nothing to sit under.
% graphicx is loaded explicitly because pandoc only loads it when the body itself
% contains an image.
\usepackage{graphicx}
% titling supplies \pretitle/\posttitle; it is in BasicTeX.
\usepackage{titling}
\makeatletter
\def\mcpl@logo{__LOGO_PATH__}
\def\mcpl@stamp{__DOC_STAMP__}
% The KOMA classes define \subtitle themselves, so pandoc's \providecommand for it
% is a no-op and its \subtitle{...} stores the value in KOMA's own variable — which
% only KOMA's \maketitle reads, and titling has replaced that. The subtitle was
% captured and then silently dropped (issue #5). Emit it here.
%
% \providecommand gives the non-KOMA classes an empty \@subtitle, so the branch
% below is simply skipped there and pandoc's own subtitle handling still runs — no
% double printing.
\providecommand{\@subtitle}{}
\newcommand{\mcpl@subtitleblock}{%
  \ifx\@subtitle\@empty\else
    \begin{center}\large\@subtitle\end{center}\vskip 0.2em
  \fi
}
\newcommand{\mcpl@stampblock}{%
  \ifx\mcpl@stamp\@empty\else
    \begin{center}\small\mcpl@stamp\end{center}
  \fi
}
% Each block guards itself, so \posttitle is set unconditionally: it closes the
% centre \pretitle opened (or titling's own) and then emits whatever exists.
\ifx\mcpl@logo\@empty\else
  \pretitle{\begin{center}\includegraphics[height=48pt]{\mcpl@logo}\\[1.2em]%
    \LARGE}
\fi
\posttitle{\par\end{center}\mcpl@subtitleblock\mcpl@stampblock\vskip 0.5em}
\makeatother
