% Type: komabook — a KOMA-Script report (scrreprt) for long-form documentation.
% The KOMA counterpart of `reference`: chapters, one-sided, a deep TOC.
%
% Preferred over `reference` when you want KOMA's typography — computed type area,
% \setkomafont heading control, and chapter openings that are already restrained
% (the standard classes spend a third of the page announcing "Chapter 3", which
% `reference` has to undo by hand).
%
% The server sets documentclass=scrreprt, oneside,
% --top-level-division=chapter and toc_depth 3 (TYPE_CLASSES).
\usepackage{fancyhdr}
\usepackage{lastpage}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

% One-sided running heads: chapter left, section right, page number bottom right.
% The LE/RO recto-verso split these used to carry is meaningless without twoside,
% which is off by default now that these are read on screen rather than bound.
\fancyhead[L]{\small\itshape\nouppercase{\leftmark}}
\fancyhead[R]{\small\itshape\nouppercase{\rightmark}}
\fancyfoot[R]{\small\thepage}
% Title, then the creation date and version the server substitutes.
\fancyfoot[L]{\small __TITLE__}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% KOMA sets \chaptermark/\sectionmark itself but strips the number; put it back so
% the running heads carry "3 Ingest API" rather than a bare title.
\renewcommand{\chaptermark}[1]{\markboth{\thechapter\quad #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\quad #1}}

% Headings come from \setkomafont, not \@startsection — see types/koma.
\newcommand{\headingsclaimed}{}
\providecommand{\komaheadcolor}{}
\AtBeginDocument{\addtokomafont{disposition}{\komaheadcolor}}

% Reference text is scanned rather than read through: paragraph separation and no
% first-line indent make an entry easier to find on the page.
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}

% --- Title block ------------------------------------------------------------
% Optional logo above the title, and the creation date and version below it.
%
% The stamp belongs HERE and nowhere else. It was in the page footer, which put a
% generation date on every single page — noise on a thirty-page document, and it
% competed with the folio for attention. A document is created once, so it says so
% once, on the first page under its own title.
%
% Nothing is discovered automatically: a file happening to be named logo.png near
% the input should not silently appear in a document.
%
% pandoc emits \maketitle only when the document has a title, so a titleless
% document never reaches any of this — and then there is nothing to sit under.
% graphicx is loaded explicitly because pandoc only loads it when the body itself
% contains an image.
\usepackage{graphicx}
% titling supplies \pretitle/\posttitle; it is in BasicTeX.
\usepackage{titling}
\makeatletter
\newcommand{\mcpl@logo}{__LOGO_PATH__}
\newcommand{\mcpl@stamp}{__DOC_STAMP__}
% \posttitle has to be set whenever EITHER a logo or a stamp is present, and it
% must close whatever \pretitle opened — hence the four-way split rather than two
% independent \ifx blocks.
\ifx\mcpl@logo\@empty
  \ifx\mcpl@stamp\@empty\else
    \posttitle{\par\end{center}%
      \begin{center}\small\mcpl@stamp\end{center}\vskip 0.5em}
  \fi
\else
  \pretitle{\begin{center}\includegraphics[height=48pt]{\mcpl@logo}\\[1.2em]%
    \LARGE}
  \ifx\mcpl@stamp\@empty
    \posttitle{\par\end{center}\vskip 0.5em}
  \else
    \posttitle{\par\end{center}%
      \begin{center}\small\mcpl@stamp\end{center}\vskip 0.5em}
  \fi
\fi
\makeatother
