% Type: report — the default. Running header with title left, optional label
% right, page marker in the footer. Suits PRDs, specs, longer documents.
% Concatenated BEFORE the layout partial, so layouts can override any of this.
\usepackage{fancyhdr}
\usepackage{lastpage}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\itshape __TITLE__}
\fancyhead[R]{\small\itshape __HEADER_RIGHT__}
\fancyfoot[R]{\small \thepage/\pageref{LastPage}}
% Creation date (and version, if given) opposite the folio. __DOC_STAMP__ is
% substituted by the server and collapses to nothing when both are absent.
\fancyfoot[L]{\small __DOC_STAMP__}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\small \thepage/\pageref{LastPage}}%
  \fancyfoot[L]{\small __DOC_STAMP__}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% --- Title-block logo -------------------------------------------------------
% An optional device above the document title on page one, from the caller's
% `logo_path`. Nothing is discovered automatically: a file happening to be named
% logo.png near the input should not silently appear in a document.
%
% pandoc emits \maketitle only when the document has a title, so a titleless
% document simply never reaches this. graphicx is loaded explicitly because pandoc
% only loads it when the body itself contains an image.
\usepackage{graphicx}
% titling supplies \pretitle/\posttitle; it is in BasicTeX.
\usepackage{titling}
\makeatletter
\newcommand{\mcpl@logo}{__LOGO_PATH__}
\ifx\mcpl@logo\@empty\else
  \pretitle{\begin{center}\includegraphics[height=48pt]{\mcpl@logo}\\[1.2em]%
    \LARGE}
  \posttitle{\par\end{center}\vskip 0.5em}
\fi
\makeatother
